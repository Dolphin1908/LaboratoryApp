<Page x:Class="LaboratoryApp.src.UI.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaboratoryApp.src.UI.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{DynamicResource MaterialDesignFont}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome"
      DataContext="{Binding DashboardVM}">
    <Grid Margin="100, 0"
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Stretch">
            <Image Source="/resources/Images/Laboratory.png" 
                   Width="64" 
                   Height="64" 
                   Margin="0,0,0,20"/>
            <TextBlock Text="Welcome to Laboratory App" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="8" 
                       HorizontalAlignment="Center"/>
            <Grid Margin="20"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" 
                      Grid.Column="0" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="SpringGreen"
                            BorderBrush="SpringGreen"
                            Command="{Binding NavigateToChemistryMainPage}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FlaskEmptyOutline" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="Hóa học"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <Grid Grid.Row="0" 
                      Grid.Column="1" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#ffff72"
                            BorderBrush="#ffff72"
                            Command="{Binding }">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightningBoltOutline" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="Vật Lý"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <Grid Grid.Row="1" 
                      Grid.Column="0" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#ff9e40"
                            BorderBrush="#ff9e40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HexagonOutline" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="Toán Học"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <Grid Grid.Row="1" 
                      Grid.Column="1" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#ff96c8"
                            BorderBrush="#ff96c8"
                            Command="{Binding NavigateToEnglishMainPage}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChatOutline" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="Tiếng Anh"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <Grid Grid.Row="2" 
                      Grid.Column="0" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#9bb2f3"
                            BorderBrush="#9bb2f3"
                            Command="{Binding NavigateToAssignmentMainPage}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenVariantOutline" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="Bài tập"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" 
                      Grid.Column="1" 
                      Margin="10, 0, 10, 10"
                      VerticalAlignment="Stretch">
                    <Button Height="100"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#f39b9b"
                            BorderBrush="#f39b9b"
                            Command="{Binding }">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cancel" Margin="0,0,10,0"
                                                     Height="18" Width="18"/>
                            <TextBlock Text="None"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
