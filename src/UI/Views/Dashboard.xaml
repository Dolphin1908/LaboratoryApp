<Page
    x:Class="LaboratoryApp.src.UI.Views.Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.UI.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Welcome"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    DataContext="{Binding DashboardVM}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid
        Margin="100,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Stretch">
            <Image
                Width="64"
                Height="64"
                Margin="0,0,0,20"
                Source="/resources/Images/Laboratory.png" />
            <TextBlock
                Margin="8"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Welcome to Laboratory App" />
            <Grid
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#92ff9f"
                        BorderBrush="#92ff9f"
                        Command="{Binding NavigateToChemistryMainPage}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="FlaskEmptyOutline" />
                            <TextBlock FontSize="16" Text="Hóa học" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#fff991"
                        BorderBrush="#fff991"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="LightningBoltOutline" />
                            <TextBlock FontSize="16" Text="Comming soon" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ff9e40"
                        BorderBrush="#ff9e40"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="HexagonOutline" />
                            <TextBlock FontSize="16" Text="Comming soon" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ff96c8"
                        BorderBrush="#ff96c8"
                        Command="{Binding NavigateToEnglishMainPage}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="ChatOutline" />
                            <TextBlock FontSize="16" Text="Tiếng Anh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#9bb2f3"
                        BorderBrush="#9bb2f3"
                        Command="{Binding NavigateToAssignmentMainPage}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="BookOpenVariantOutline" />
                            <TextBlock FontSize="16" Text="Bài tập" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#f39b9b"
                        BorderBrush="#f39b9b"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                Kind="Cancel" />
                            <TextBlock FontSize="16" Text="Comming soon" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
