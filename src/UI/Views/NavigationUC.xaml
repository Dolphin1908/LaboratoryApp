<UserControl
    x:Class="LaboratoryApp.src.UI.Views.NavigationUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.UI.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Border
        MaxWidth="160"
        Margin="0,5"
        BorderBrush="LightGray"
        BorderThickness="0,0,1,0">
        <wpfui:NavigationView
            x:Name="RootNavigation"
            HorizontalAlignment="Center"
            IsBackButtonVisible="Collapsed"
            Loaded="RootNavigation_Loaded">

            <wpfui:NavigationView.MenuItems>
                <!--  Dashboard  -->
                <wpfui:NavigationViewItem Command="{Binding NavigateToDashboardCommand}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="Home" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon FontSize="24" Symbol="Home12" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <!--  Periodic Table  -->
                <wpfui:NavigationViewItem Command="{Binding OpenPeriodicTableCommand}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="Periodic Table" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon FontSize="24" Symbol="Beaker16" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <!--  Toolkit  -->
                <wpfui:NavigationViewItem Command="{Binding NavigateToToolkitCommand}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="Toolkits" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon FontSize="24" Symbol="Toolbox12" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <wpfui:NavigationViewItem Command="{Binding NavigateToTeacherMainPageCommand}" Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="#F2CB5C"
                            Text="Teacher Panel" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Foreground="#F2CB5C"
                            Symbol="PersonStar24" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <wpfui:NavigationViewItem Command="{Binding NavigateToTeacherToolboxCommand}" Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="#F2CB5C"
                            Text="Teacher Tools" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Foreground="#F2CB5C"
                            Symbol="Wrench24" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>
            </wpfui:NavigationView.MenuItems>

            <wpfui:NavigationView.FooterMenuItems>
                <wpfui:NavigationViewItem Command="{Binding OpenSwitchOrganizationCommand}" Visibility="{Binding CanSwitchOrganization, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="MediumPurple"
                            Text="Change Role" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Foreground="MediumPurple"
                            Symbol="ArrowSwap24" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <wpfui:NavigationViewItem>
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="{Binding CurrentUser}" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Symbol="PersonCircle24" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <wpfui:NavigationViewItem Command="{Binding LogoutCommand}" Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="Red"
                            Text="Logout" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Foreground="Red"
                            Symbol="SignOut20" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>

                <wpfui:NavigationViewItem Command="{Binding OpenAuthenticationCommand}" Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <wpfui:NavigationViewItem.Content>
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="SpringGreen"
                            Text="Login" />
                    </wpfui:NavigationViewItem.Content>
                    <wpfui:NavigationViewItem.Icon>
                        <wpfui:SymbolIcon
                            Filled="True"
                            FontSize="24"
                            Foreground="SpringGreen"
                            Symbol="Key16" />
                    </wpfui:NavigationViewItem.Icon>
                </wpfui:NavigationViewItem>
            </wpfui:NavigationView.FooterMenuItems>
        </wpfui:NavigationView>
    </Border>

