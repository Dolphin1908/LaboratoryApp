<Window
    x:Class="LaboratoryApp.src.UI.Views.TestUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.UI.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Create New Assignment"
    Width="1200"
    Height="800"
    Background="#F5F7FA"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header & Stepper  -->
            <RowDefinition Height="*" />
            <!--  Main Content  -->
            <RowDefinition Height="Auto" />
            <!--  Footer Actions  -->
        </Grid.RowDefinitions>

        <!--  HEADER AREA  -->
        <Grid Grid.Row="0" Margin="24,24,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                FontWeight="Bold"
                Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                Text="Create New Assignment" />

            <!--  STEPPER / WIZARD NAVIGATION (Giả lập)  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Step 1  -->
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Foreground="#000"
                    Kind="Numeric1Circle" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="#000"
                    Text="Details" />
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Kind="ArrowRight" />

                <!--  Step 2  -->
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Margin="10,0,0,0"
                    Foreground="Gray"
                    Kind="Numeric2CircleOutline" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="Questions" />
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Kind="ArrowRight" />

                <!--  Step 3  -->
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Margin="10,0,0,0"
                    Foreground="Gray"
                    Kind="Numeric3CircleOutline" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="Settings" />
            </StackPanel>
        </Grid>

        <!--  MAIN CONTENT: TRANSITIONER (Slide Navigation)  -->
        <materialDesign:Transitioner
            Grid.Row="1"
            AutoApplyTransitionOrigins="True"
            SelectedIndex="0">

            <!--  ================= SLIDE 1: DETAILS =================  -->
            <materialDesign:TransitionerSlide>
                <ScrollViewer>
                    <materialDesign:Card
                        Margin="24"
                        Padding="32"
                        UniformCornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,24"
                                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                Text="Assignment Details" />

                            <!--  Title Input  -->
                            <TextBox
                                Height="50"
                                Margin="0,0,0,24"
                                materialDesign:HintAssist.Hint="Assignment Title"
                                FontSize="16"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <!--  Assign To (Chips)  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                Text="Assign To" />
                            <Border
                                Padding="8"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="4">
                                <WrapPanel>
                                    <materialDesign:Chip
                                        Margin="0,0,8,0"
                                        Background="#E3F2FD"
                                        Content="Class 10A1"
                                        Foreground="#1565C0"
                                        IsDeletable="True" />
                                    <materialDesign:Chip
                                        Margin="0,0,8,0"
                                        Background="#E3F2FD"
                                        Content="Class 10A2"
                                        Foreground="#1565C0"
                                        IsDeletable="True" />
                                    <Button
                                        Height="32"
                                        Content="+ Add Class"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </WrapPanel>
                            </Border>

                            <!--  Date Pickers  -->
                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:TimePicker
                                    Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Start Time"
                                    Style="{StaticResource MaterialDesignOutlinedTimePicker}" />
                                <materialDesign:TimePicker
                                    Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Due Time"
                                    Style="{StaticResource MaterialDesignOutlinedTimePicker}" />
                            </Grid>

                            <!--  Duration Slider  -->
                            <TextBlock
                                Margin="0,24,0,8"
                                Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                Text="Duration (minutes)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="120"
                                    TickFrequency="5"
                                    Value="45" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="50"
                                    Margin="16,0,0,0"
                                    HorizontalContentAlignment="Center"
                                    Text="45" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </materialDesign:TransitionerSlide>

            <!--  ================= SLIDE 2: QUESTIONS =================  -->
            <materialDesign:TransitionerSlide>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!--  Left: Question Bank  -->
                    <materialDesign:Card
                        Grid.Column="0"
                        Padding="0"
                        UniformCornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="20"
                                FontWeight="Bold"
                                Text="Question Bank" />

                            <StackPanel Grid.Row="1" Margin="20,0">
                                <TextBox
                                    Margin="0,0,0,10"
                                    materialDesign:HintAssist.Hint="Search..."
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                <WrapPanel Margin="0,0,0,10">
                                    <materialDesign:Chip
                                        Height="24"
                                        Content="Math"
                                        FontSize="10" />
                                    <materialDesign:Chip
                                        Height="24"
                                        Content="Chap 1"
                                        FontSize="10" />
                                    <materialDesign:Chip
                                        Height="24"
                                        Content="Hard"
                                        FontSize="10" />
                                </WrapPanel>
                            </StackPanel>

                            <ListBox Grid.Row="2" Margin="10">
                                <ListBoxItem>
                                    <Border
                                        Width="550"
                                        Margin="0,4"
                                        Padding="12"
                                        BorderBrush="#EEEEEE"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Padding="4,2"
                                                HorizontalAlignment="Left"
                                                Background="#E3F2FD"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="Blue"
                                                    Text="MCQ" />
                                            </Border>
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Text="Question preview of a question 1?..."
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Row="1"
                                                Height="28"
                                                Padding="10,0"
                                                HorizontalAlignment="Right"
                                                Content="Add"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                                        </Grid>
                                    </Border>
                                </ListBoxItem>
                                <!--  More items here  -->
                            </ListBox>
                        </Grid>
                    </materialDesign:Card>

                    <!--  Right: Selected Questions  -->
                    <materialDesign:Card Grid.Column="2" UniformCornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="16"
                                FontWeight="Bold"
                                Text="Selected Questions (5)" />

                            <ScrollViewer Grid.Row="1">
                                <StackPanel Margin="10">
                                    <!--  Selected Item Template  -->
                                    <Border
                                        Margin="4"
                                        Padding="8"
                                        Background="White"
                                        CornerRadius="4"
                                        Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                VerticalAlignment="Center"
                                                Foreground="Gray"
                                                Kind="DragVertical" />
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock FontWeight="SemiBold" Text="Question 1..." />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="Preview..." />
                                            </StackPanel>
                                            <TextBox
                                                Grid.Column="2"
                                                Width="30"
                                                VerticalAlignment="Center"
                                                materialDesign:HintAssist.Hint="Pts"
                                                Text="1" />
                                            <Button
                                                Grid.Column="3"
                                                Width="24"
                                                Height="24"
                                                Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Foreground="Red" Kind="Delete" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                Grid.Row="2"
                                Padding="16"
                                Background="#F5F5F5">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold"
                                    Text="Total Score: 10 pts" />
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </materialDesign:TransitionerSlide>

            <!--  ================= SLIDE 3: SETTINGS =================  -->
            <materialDesign:TransitionerSlide>
                <ScrollViewer>
                    <StackPanel MaxWidth="800" Margin="24">
                        <TextBlock
                            Margin="0,0,0,20"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Text="Configuration" />

                        <!--  Settings Group 1  -->
                        <materialDesign:Card
                            Margin="0,0,0,20"
                            Padding="20"
                            UniformCornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    FontWeight="Bold"
                                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                    Text="1. Security" />

                                <Grid Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Shuffle Questions" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="Gray"
                                            Text="Randomize order for each student" />
                                    </StackPanel>
                                    <ToggleButton
                                        HorizontalAlignment="Right"
                                        IsChecked="True"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                </Grid>
                                <Separator />
                                <Grid Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Shuffle Answers" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="Gray"
                                            Text="Randomize choices within MCQ" />
                                    </StackPanel>
                                    <ToggleButton HorizontalAlignment="Right" Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!--  Settings Group 2  -->
                        <materialDesign:Card Padding="20" UniformCornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    FontWeight="Bold"
                                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                    Text="2. Attempts" />
                                <ComboBox materialDesign:HintAssist.Hint="Allowed Attempts" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="1 Attempt" IsSelected="True" />
                                    <ComboBoxItem Content="2 Attempts" />
                                    <ComboBoxItem Content="Unlimited" />
                                </ComboBox>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </materialDesign:TransitionerSlide>

        </materialDesign:Transitioner>

        <!--  FOOTER ACTIONS  -->
        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0">
            <Grid>
                <Button
                    Width="100"
                    HorizontalAlignment="Left"
                    Content="Back"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,16,0"
                        Content="Save as Draft"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Publish Assignment" Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
