<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LaboratoryApp.src.Shared.Converters"
    xmlns:ctrl="clr-namespace:LaboratoryApp.src.Shared.Controls"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules">

    <!--  Converter  -->
    <converters:BlankToVisibilityConverter x:Key="BlankToVisibilityConverter" />
    <converters:BooleanToAngleConverter x:Key="BooleanToAngleConverter" />
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <converters:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
    <converters:FlipConverter x:Key="FlipConverter" />
    <converters:HighestNameFlagConverter x:Key="HighestNameFlagConverter" />
    <converters:HtmlToDataUriConverter x:Key="HtmlToDataUriConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

    <!--  Domain  -->
    <rules:NotEmptyValidationRule x:Key="NotEmptyValidationRule" />

    <!--  Control  -->
    <ctrl:BindableWebView2 x:Key="BindableWebView2" />

</ResourceDictionary>