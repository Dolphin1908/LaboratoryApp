<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:LaboratoryApp.src.Shared.Controls"
    xmlns:cv="clr-namespace:LaboratoryApp.src.Shared.Converters"
    xmlns:domain="clr-namespace:LaboratoryApp.src.Core.Domains">

    <!--  Converter  -->
    <cv:BlankToVisibilityConverter x:Key="BlankToVisibilityConverter" />
    <cv:BooleanToAngleConverter x:Key="BooleanToAngleConverter" />
    <cv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <cv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <cv:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
    <cv:FlipConverter x:Key="FlipConverter" />
    <cv:HighestNameFlagConverter x:Key="HighestNameFlagConverter" />
    <cv:HtmlToDataUriConverter x:Key="HtmlToDataUriConverter" />
    <cv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <cv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

    <!--  Domain  -->
    <domain:NotEmptyValidationRule x:Key="NotEmptyValidationRule" />

    <!--  Control  -->
    <ctrl:BindableWebView2 x:Key="BindableWebView2" />

</ResourceDictionary>