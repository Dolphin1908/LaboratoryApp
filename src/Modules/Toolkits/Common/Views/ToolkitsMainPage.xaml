<Page
    x:Class="LaboratoryApp.src.Modules.Toolkits.Common.Views.ToolkitsMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Toolkits.Common.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Toolkits"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid
        Margin="100,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Stretch">

            <Image
                Width="64"
                Height="64"
                Margin="0,0,0,20"
                Source="/resources/Images/Laboratory.png" />
            <TextBlock
                Margin="8"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Welcome to Toolkits" />

            <Grid
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding OpenCalculatorCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock FontSize="16" Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
                            <TextBlock Text="Máy tính cơ bản" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderBrush="SpringGreen"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,10,0" Kind="Calculator" />
