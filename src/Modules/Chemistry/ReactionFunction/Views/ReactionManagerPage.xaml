<Page x:Class="LaboratoryApp.src.Modules.Chemistry.ReactionFunction.Views.ReactionManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Chemistry.ReactionFunction.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{DynamicResource MaterialDesignFont}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Reaction">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Margin="5">
            <!-- Search bar -->
            <Grid Margin="5,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Name="Reactants"
                         Grid.Column="0"
                         Text="{Binding Reactants, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Chất tham gia"
                         VerticalAlignment="Center"
                         BorderThickness="1"
                         Background="Transparent"
                         BorderBrush="Black"
                         Foreground="Black"
                         CaretBrush="Black"/>

                <materialDesign:PackIcon Kind="ArrowRightThin"
                                         Grid.Column="1"
                                         Height="30"
                                         Width="30"
                                         Margin="5,0"
                                         VerticalAlignment="Center"/>

                <TextBox Name="Products"
                         Grid.Column="2"
                         Text="{Binding Products, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Chất sản phẩm"
                         VerticalAlignment="Center"
                         BorderThickness="1"
                         Background="Transparent"
                         BorderBrush="Black"
                         Foreground="Black"
                         CaretBrush="Black"
                         Margin="0"/>

                <!-- Search reaction button -->
                <Button Grid.Column="3"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        BorderThickness="0"
                        Background="Wheat"
                        Margin="10,0,0,0"
                        Height="Auto"
                        Width="Auto"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding SearchReactionCommand}">
                    <Grid VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Grid.Column="0"
                                                 Width="20"
                                                 Height="20"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Tìm kiếm"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Add reaction button -->
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    BorderThickness="0"
                    Background="SpringGreen"
                    Margin="5,0,5,10"
                    Height="30"
                    Width="200"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding AddReactionCommand}">
                <Grid VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Add"
                                             Grid.Column="0"
                                             Width="20"
                                             Height="20"
                                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Thêm phản ứng"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Separator Width="200"
                       Height="1"
                       Background="Gray"
                       BorderBrush="Gray"/>

        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      Margin="5,0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Reactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent"
                                Cursor="Hand"
                                BorderThickness="1"
                                BorderBrush="DarkGray"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Margin="5"
                                Height="50"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.SelectReactionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding .}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{Binding DisplayEquation}"
                                           Foreground="SlateBlue"
                                           FontSize="20"
                                           FontWeight="DemiBold" 
                                           Margin="10,0"/>

                                <Grid Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          VerticalAlignment="Center"
                                          MinWidth="70"
                                          Visibility="{Binding YieldPercent, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{Binding YieldPercent}"
                                                   Grid.Column="0"
                                                   HorizontalAlignment="Right"
                                                   FontSize="16"/>
                                        <TextBlock Text=" %"
                                                   Grid.Column="1"/>
                                    </Grid>

                                    <Grid Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0"
                                          MinWidth="80"
                                          Visibility="{Binding Condition.Temperature, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{Binding Condition.Temperature}"
                                                   Grid.Column="0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="OrangeRed"
                                                   FontSize="16"/>
                                        <TextBlock Text=" °C"
                                                   Grid.Column="1"
                                                   Foreground="OrangeRed"/>
                                    </Grid>

                                    <Grid Grid.Column="2"
                                          VerticalAlignment="Center"
                                          MinWidth="70"
                                          Visibility="{Binding Condition.Pressure, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{Binding Condition.Pressure}"
                                                   Grid.Column="0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="BlueViolet"
                                                   FontSize="16"/>
                                        <TextBlock Text=" atm"
                                                   Grid.Column="1"
                                                   Foreground="BlueViolet"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
