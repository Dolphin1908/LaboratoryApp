<Page
    x:Class="LaboratoryApp.src.Modules.Student.English.FlashcardFunction.Views.FlashcardManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Student.English.FlashcardFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Flashcard Manager"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Flashcard Manager  -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Height="24"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Kind="Magnify" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CaretBrush="Black"
                        Foreground="Black"
                        Style="{x:Null}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Button
                Grid.Row="1"
                Height="32"
                Margin="0,5"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="SpringGreen"
                BorderThickness="0"
                Command="{Binding AddFlashcardSetCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Kind="Add" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="Thêm bộ mới" />
                </Grid>
            </Button>

            <Separator
                Grid.Row="2"
                Width="200"
                Height="1"
                Margin="0,5"
                Background="Gray"
                BorderBrush="Gray" />
            <!--  Flashcard List  -->
            <ScrollViewer
                Grid.Row="3"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding FlashcardSets, UpdateSourceTrigger=PropertyChanged}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:FlashcardSetTagUC Margin="5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!--  Flashcard Details  -->
        <Border
            Grid.Column="1"
            Padding="10"
            BorderBrush="Black"
            BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 1  -->
                <Border
                    Margin="5,0"
                    Padding="0,0,0,5"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="40"
                            FontWeight="Bold"
                            Text="{Binding SelectedFlashcardSet.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Width="120"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Padding="0,0,5,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Background="Cyan"
                                    BorderThickness="0"
                                    Command="{Binding OpenUpdateFlashcardSetWindowCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            Kind="Edit" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Sửa bộ" />
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Width="120"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Padding="0,0,5,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Background="Red"
                                    BorderThickness="0"
                                    Command="{Binding DeleteFlashcardSetCommand}"
                                    CommandParameter="{Binding SelectedFlashcardSet}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            Kind="Delete" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Xóa bộ" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,5,5,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock FontStyle="Italic" Text="Last updated: " />
                                <TextBlock FontStyle="Italic" Text="{Binding SelectedFlashcardSet.LastUpdatedDate, StringFormat=HH:mm:ss dd/MM/yyyy, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Row 2  -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="5,0"
                        Padding="0,10"
                        BorderBrush="Gray">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" MaxWidth="100" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" MaxWidth="200" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="5,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Từ" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Từ loại" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="5,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Nghĩa" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="5,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Thời gian chờ" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="5,0,0,0"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding SelectedFlashcardSet.Flashcards, UpdateSourceTrigger=PropertyChanged}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:FlashcardTagUC Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>


                <!--  Row 3  -->
                <DockPanel Grid.Row="2" Margin="5,10,5,0">
                    <Border
                        Padding="0,10,0,0"
                        BorderBrush="Gray"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Width="250"
                                Height="64"
                                Padding="0,0,5,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Background="SpringGreen"
                                BorderThickness="0"
                                Command="{Binding OpenAddFlashcardWindowCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        Kind="Add" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Thêm thẻ mới" />
                                </Grid>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Width="250"
                                Height="64"
                                Padding="0,0,5,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Background="Cyan"
                                BorderThickness="0"
                                Command="{Binding StartFlashcardSetCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanStartSet, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Visibility="{Binding SelectedFlashcardSet, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        Kind="Play" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Bắt đầu" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
