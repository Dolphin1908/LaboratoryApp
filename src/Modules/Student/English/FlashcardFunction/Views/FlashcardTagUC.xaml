<UserControl
    x:Class="LaboratoryApp.src.Modules.Student.English.FlashcardFunction.Views.FlashcardTagUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Student.English.FlashcardFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    Height="Auto"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Border
        Margin="0,0,5,0"
        BorderBrush="Gray"
        BorderThickness="0,1,0,0">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MaxWidth="100" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MaxWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="1"
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="{Binding Pos, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="2"
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="3"
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="{Binding NextReview, StringFormat=HH:mm dd/MM/yyyy, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="4"
                Margin="0,0,5,0"
                Padding="0"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.OpenUpdateFlashcardWindowCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding Id}">
                <materialDesign:PackIcon
                    Width="Auto"
                    Height="Auto"
                    Kind="Edit" />
            </Button>

            <Button
                Grid.Column="5"
                Padding="0"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.DeleteFlashcardCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding Id}">
                <materialDesign:PackIcon
                    Width="Auto"
                    Height="Auto"
                    Foreground="Red"
                    Kind="Delete" />
            </Button>
        </Grid>
    </Border>
</UserControl>
