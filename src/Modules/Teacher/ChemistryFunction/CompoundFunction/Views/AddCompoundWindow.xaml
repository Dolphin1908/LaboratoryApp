<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.Chemistry.CompoundFunction.Views.AddCompoundWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Chemistry.CompoundFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules"
    Title="Thêm hợp chất mới"
    Width="1220"
    Height="600"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <!--  Phần thông tin hợp chất  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Thông tin hợp chất" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!--  Tên hợp chất  -->
                        <TextBox
                            Margin="0,5,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Tên hợp chất"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}">
                            <TextBox.Text>
                                <Binding Path="Compound.Name" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <rules:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <!--  Công thức hợp chất  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Công thức hợp chất"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}">
                            <TextBox.Text>
                                <Binding Path="Compound.Formula" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <rules:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <!--  Khối lượng mol  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Khối lượng mol"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}">
                            <TextBox.Text>
                                <Binding Path="Compound.MolecularMass" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <rules:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <!--  Tên người phát hiện  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Tên người phát hiện"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Compound.Author}" />

                        <!--  Màu hợp chất  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Màu hợp chất"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Compound.CompoundColor}" />

                        <!--  Mã màu hợp chất  -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.Hint="Mã màu (HEX) hợp chất (nếu có)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Compound.CompoundColorCode}" />
                            <Border
                                Grid.Column="1"
                                Width="15"
                                Height="50"
                                Background="{Binding Compound.CompoundColorCode, Converter={StaticResource ColorToBrushConverter}, UpdateSourceTrigger=PropertyChanged}"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="3" />
                        </Grid>

                        <!--  Loại hợp chất  -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.Hint="Loại hợp chất"
                                Focusable="False"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SelectedCompoundTypeNames, Mode=OneWay}"
                                TextWrapping="WrapWithOverflow" />

                            <!--  Nút để mở popup  -->
                            <ToggleButton
                                Name="TypeToggle"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="▾"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                            <!--  Popup sẽ xuất hiện dưới ToggleButton  -->
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsChecked, ElementName=TypeToggle}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=TypeToggle}"
                                PopupAnimation="Fade"
                                StaysOpen="False">
                                <Border
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <ListView
                                            Width="250"
                                            Height="150"
                                            materialDesign:ListBoxItemAssist.ShowSelection="False"
                                            ItemsSource="{Binding CompoundTypeOptions}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!--  Trạng thái hợp chất  -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.Hint="Trạng thái"
                                Focusable="False"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SelectedPhaseNames, Mode=OneWay}"
                                TextWrapping="WrapWithOverflow" />

                            <!--  Nút để mở popup  -->
                            <ToggleButton
                                Name="PhaseToggle"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="▾"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                            <!--  Popup sẽ xuất hiện dưới ToggleButton  -->
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsChecked, ElementName=PhaseToggle}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=PhaseToggle}"
                                PopupAnimation="Fade"
                                StaysOpen="False">
                                <Border
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <ListView
                                            Width="250"
                                            Height="150"
                                            materialDesign:ListBoxItemAssist.ShowSelection="False"
                                            ItemsSource="{Binding PhaseOptions}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!--  Khối lượng riêng  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Khối lượng riêng (g/cm³)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Compound.Density}" />

                        <!--  Mã số đăng ký  -->
                        <TextBox
                            Margin="0,0,0,10"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Mã số đăng ký (CAS)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Compound.CASNumber}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border
                Width="1"
                Height="500"
                BorderBrush="Black"
                BorderThickness="1" />

            <!--  Phần Cấu tạo  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header + Button cố định  -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Cấu tạo (Nguyên tố)" />
                    <Button
                        Width="218"
                        Margin="0,5,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddElementCommand}"
                        Content="Thêm nguyên tố"
                        Foreground="Black"
                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                </StackPanel>

                <!--  Nội dung cuộn  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Composition}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                                    <!--  Nội dung từng phần tử  -->
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedElement.Formula}" />
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <ComboBox
                                            Width="120"
                                            materialDesign:HintAssist.Hint="Nguyên tố"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding DataContext.AllElements, RelativeSource={RelativeSource AncestorType=Window}}"
                                            SelectedItem="{Binding SelectedElement, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                        <TextBox
                                            Width="90"
                                            Margin="5,0"
                                            HorizontalContentAlignment="Center"
                                            materialDesign:HintAssist.Hint="Số lượng"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button
                                        Command="{Binding DataContext.RemoveElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Xóa"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border
                Width="1"
                Height="500"
                BorderBrush="Black"
                BorderThickness="1" />

            <!--  Phần Tính chất Vật lý  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Tính chất Vật lý" />
                    <Button
                        Width="218"
                        Margin="0,5,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddPhysicalPropertyCommand}"
                        Content="Thêm tính chất"
                        Foreground="Black"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding PhysicalProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <TextBox
                                        Height="50"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Tên tính chất"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding PropertyName}" />

                                    <StackPanel
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBox
                                            Width="100"
                                            Margin="0,0,10,0"
                                            materialDesign:HintAssist.Hint="Giá trị"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Value}" />

                                        <ComboBox
                                            Width="110"
                                            materialDesign:HintAssist.Hint="Đơn vị"
                                            IsEditable="True"
                                            ItemsSource="{Binding DataContext.AllUnits, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                            Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBox
                                        Height="Auto"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Mô tả"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Command="{Binding DataContext.RemovePhysicalPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Xóa"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border
                Width="1"
                Height="500"
                BorderBrush="Black"
                BorderThickness="1" />

            <!--  Phần Tính chất Hóa học  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Tính chất Hóa học" />
                    <Button
                        Width="218"
                        Margin="0,5,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddChemicalPropertyCommand}"
                        Content="Thêm tính chất"
                        Foreground="Black"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding ChemicalProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <TextBox
                                        Height="50"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Tên tính chất"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding PropertyName}" />

                                    <TextBox
                                        Height="Auto"
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Mô tả"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Command="{Binding DataContext.RemoveChemicalPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Xóa"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border
                Width="1"
                Height="500"
                BorderBrush="Black"
                BorderThickness="1" />

            <!--  Phần Ghi chú  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Ghi chú" />
                    <Button
                        Width="218"
                        Margin="0,5,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddNoteGroupCommand}"
                        Content="Thêm nhóm ghi chú"
                        Foreground="Black"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <ComboBox
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Loại note"
                                        DisplayMemberPath="DisplayName"
                                        IsEditable="False"
                                        ItemsSource="{Binding NoteTypeOptions}"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                        SelectedValue="{Binding CompoundNoteType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                    <!--  Danh sách nội dung cho từng loại  -->
                                    <ItemsControl ItemsSource="{Binding CompoundNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox
                                                        Grid.Column="0"
                                                        Height="Auto"
                                                        Margin="0,0,5,0"
                                                        materialDesign:HintAssist.Hint="Mô tả"
                                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                        Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextWrapping="Wrap" />

                                                    <Button
                                                        Grid.Column="1"
                                                        Height="Auto"
                                                        Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Xóa"
                                                        Foreground="Red"
                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button
                                        Width="200"
                                        Margin="0,0,0,10"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        Background="SpringGreen"
                                        BorderThickness="0"
                                        Command="{Binding AddNoteCommand}"
                                        Content="Thêm ghi chú"
                                        Foreground="Black"
                                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                                    <Button
                                        Command="{Binding DataContext.RemoveNoteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Xóa nhóm"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </StackPanel>

        <!--  Nút Hoàn thành  -->
        <Button
            Grid.Row="1"
            Width="218"
            Margin="0,0,0,10"
            materialDesign:ButtonAssist.CornerRadius="15"
            Background="Cyan"
            BorderThickness="0"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
            Content="Done"
            Foreground="Black"
            Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
    </Grid>
</Window>
