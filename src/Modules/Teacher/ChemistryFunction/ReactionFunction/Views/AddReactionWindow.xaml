<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.Chemistry.ReactionFunction.Views.AddReactionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Chemistry.ReactionFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules"
    Title="Thêm phản ứng mới"
    Width="980"
    Height="600"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Grid
                Width="220"
                Margin="10"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Phần Thông tin Phản ứng  -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Thông tin phản ứng" />

                    <!--  Loại phản ứng  -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Loại phản ứng"
                            Focusable="False"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedReactionTypeNames, Mode=OneWay}"
                            TextWrapping="WrapWithOverflow" />

                        <!--  Nút để mở popup  -->
                        <ToggleButton
                            Name="TypeToggle"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="▾"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                        <!--  Popup sẽ xuất hiện dưới ToggleButton  -->
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=TypeToggle}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=TypeToggle}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Padding="8"
                                Background="White"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel>
                                    <ListView
                                        Width="250"
                                        Height="150"
                                        materialDesign:ListBoxItemAssist.ShowSelection="False"
                                        ItemsSource="{Binding ReactionTypeOptions}"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding DisplayName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!--  Hiệu suất phản ứng  -->
                    <TextBox
                        Margin="0,0,0,20"
                        VerticalAlignment="Top"
                        materialDesign:HintAssist.Hint="Hiệu suất phản ứng (0 - 100)"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Reaction.YieldPercent}" />

                    <!--  Tên người phát hiện  -->
                    <TextBox
                        Margin="0,0,0,20"
                        VerticalAlignment="Top"
                        materialDesign:HintAssist.Hint="Tên người phát hiện"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Reaction.Author}" />
                </StackPanel>

                <!--  Phần Điều kiện Phản ứng  -->
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Điều kiện phản ứng" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <!--  Nhiệt độ (°C)  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Nhiệt độ (°C)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Reaction.Condition.Temperature}" />

                        <!--  Áp suất (atm)  -->
                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Áp suất (atm)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Reaction.Condition.Pressure}" />


                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Chất xúc tác"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Reaction.Condition.Catalyst}" />

                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Dung môi"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Reaction.Condition.Solvent}" />

                        <TextBox
                            Margin="0,0,0,20"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.Hint="Độ pH (0 - 14)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Reaction.Condition.PH}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Các điều kiện khác" />

                        <!--  Danh sách các điều kiện  -->
                        <ItemsControl ItemsSource="{Binding OtherConditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10" Orientation="Vertical">
                                        <TextBox
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Tên điều kiện"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Name}" />
                                        <TextBox
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Mô tả điều kiện"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Description}" />
                                        <Button
                                            Command="{Binding DataContext.RemoveOtherConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Xóa"
                                            Foreground="Red"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Nút thêm điều kiện  -->
                        <Button
                            Width="218"
                            Margin="0,0,0,10"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Background="SpringGreen"
                            BorderThickness="0"
                            Command="{Binding AddOtherConditionCommand}"
                            Content="Thêm điều kiện"
                            Foreground="Black"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Separator
                Width="400"
                Height="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>

            <!--  Phần Chất tham gia  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header + Button cố định  -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Chất tham gia" />
                    <Button
                        Width="218"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddReactantCommand}"
                        Content="Thêm chất tham gia"
                        Foreground="Black"
                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                </StackPanel>

                <!--  Nội dung cuộn  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Reactants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <!--  Nội dung từng phần tử  -->
                                    <StackPanel>
                                        <ComboBox
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Loại chất"
                                            DisplayMemberPath="DisplayName"
                                            IsEditable="False"
                                            ItemsSource="{Binding DataContext.SubstanceKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            SelectedValue="{Binding Kind, Mode=TwoWay}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                        <TextBox
                                            x:Name="SearchBox"
                                            Height="Auto"
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Chất tham gia"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />

                                        <Popup
                                            Width="{Binding ActualWidth, ElementName=SearchBox}"
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsSuggestionOpen}"
                                            PlacementTarget="{Binding ElementName=SearchBox}"
                                            StaysOpen="False">
                                            <ScrollViewer
                                                MaxHeight="300"
                                                Margin="0"
                                                Background="LightGray"
                                                VerticalScrollBarVisibility="Hidden">
                                                <ListBox ItemsSource="{Binding SearchResult}" SelectedItem="{Binding SelectedSuggestion}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding Formula}" />
                                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </Popup>

                                        <TextBox
                                            Height="Auto"
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Hệ số"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Coefficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />

                                        <Button
                                            Command="{Binding DataContext.RemoveReactantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Xóa"
                                            Foreground="Red"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Separator
                Width="400"
                Height="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>

            <!--  Phần Chất sản phẩm  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Chất sản phẩm" />
                    <Button
                        Width="218"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddProductCommand}"
                        Content="Thêm chất sản phẩm"
                        Foreground="Black"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <!--  Nội dung từng phần tử  -->
                                    <StackPanel>
                                        <ComboBox
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Loại chất"
                                            DisplayMemberPath="DisplayName"
                                            IsEditable="False"
                                            ItemsSource="{Binding DataContext.SubstanceKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            SelectedValue="{Binding Kind, Mode=TwoWay}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                        <TextBox
                                            x:Name="SearchBox"
                                            Height="Auto"
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Chất sản phẩm"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />

                                        <Popup
                                            Width="{Binding ActualWidth, ElementName=SearchBox}"
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsSuggestionOpen}"
                                            PlacementTarget="{Binding ElementName=SearchBox}"
                                            StaysOpen="False">
                                            <ScrollViewer
                                                MaxHeight="300"
                                                Margin="0"
                                                Background="LightGray"
                                                VerticalScrollBarVisibility="Hidden">
                                                <ListBox ItemsSource="{Binding SearchResult}" SelectedItem="{Binding SelectedSuggestion}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Text="{Binding Formula}" />
                                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </Popup>

                                        <TextBox
                                            Height="Auto"
                                            Margin="0,0,0,10"
                                            materialDesign:HintAssist.Hint="Hệ số"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding Coefficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />

                                        <Button
                                            Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Xóa"
                                            Foreground="Red"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Separator
                Width="400"
                Height="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>

            <!--  Phần Ghi chú  -->
            <Grid Width="220" Margin="10">
                <Grid.RowDefinitions>
                    <!--  Hàng Auto: tiêu đề + nút thêm  -->
                    <RowDefinition Height="Auto" />
                    <!--  Hàng *: phần cuộn  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Ghi chú" />
                    <Button
                        Width="218"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddNoteGroupCommand}"
                        Content="Thêm nhóm ghi chú"
                        Foreground="Black"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                </StackPanel>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalContentAlignment="Center"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <!--  Chọn loại note  -->
                                    <ComboBox
                                        Margin="0,0,0,10"
                                        materialDesign:HintAssist.Hint="Loại note"
                                        DisplayMemberPath="DisplayName"
                                        IsEditable="False"
                                        ItemsSource="{Binding NoteTypeOptions}"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                        SelectedValue="{Binding ReactionNoteType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                    <!--  Danh sách nội dung cho từng loại  -->
                                    <ItemsControl ItemsSource="{Binding ReactionNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox
                                                        Grid.Column="0"
                                                        Height="Auto"
                                                        Margin="0,0,5,0"
                                                        materialDesign:HintAssist.Hint="Mô tả"
                                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                        Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextWrapping="Wrap" />

                                                    <Button
                                                        Grid.Column="1"
                                                        Height="Auto"
                                                        Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Xóa"
                                                        Foreground="Red"
                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button
                                        Width="200"
                                        Margin="0,0,0,10"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        Background="SpringGreen"
                                        BorderThickness="0"
                                        Command="{Binding AddNoteCommand}"
                                        Content="Thêm ghi chú"
                                        Foreground="Black"
                                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />

                                    <Button
                                        Command="{Binding DataContext.RemoveNoteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="Xóa nhóm"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </StackPanel>

        <!--  Nút Hoàn thành  -->
        <Button
            Grid.Row="1"
            Width="218"
            Margin="0,0,0,10"
            materialDesign:ButtonAssist.CornerRadius="10"
            Background="Cyan"
            BorderThickness="0"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
            Content="Done"
            Foreground="Black"
            Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
    </Grid>
</Window>
