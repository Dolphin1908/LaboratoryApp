<Page
    x:Class="LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseFunction.Views.ExerciseManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Quản lý bài tập"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Danh sách bài tập  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,11,0"
            VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Exercises, UpdateSourceTrigger=PropertyChanged}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Height="40"
                            Margin="5"
                            Background="Transparent"
                            BorderBrush="Black"
                            Command="{Binding DataContext.OpenExerciseCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                            CommandParameter="{Binding .}">
                            <Grid
                                Width="650"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    FontWeight="Bold"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0"
                                    Foreground="MediumPurple"
                                    Text="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="5,0"
                                    Foreground="MediumVioletRed"
                                    Text="{Binding Difficulty, Converter={StaticResource EnumDisplayNameConverter}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Thông tin set  -->
        <Border
            Grid.Column="1"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding SelectedExerciseSet.Title}"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,10"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            Foreground="#acacff"
                            Text="{Binding SelectedExerciseSet.OwnerInfo.Username}"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            Text="{Binding SelectedExerciseSet.Description}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom">
                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddExerciseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding IsModifier, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Kind="Add" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Thêm bài tập" />
                        </Grid>
                    </Button>

                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="Cyan"
                        BorderThickness="0"
                        Command="{Binding}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Kind="Edit" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Sửa bộ" />
                        </Grid>
                    </Button>

                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="Red"
                        BorderThickness="0"
                        Command="{Binding}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Kind="Delete" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Xóa bộ" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
