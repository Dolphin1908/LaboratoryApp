<Page
    x:Class="LaboratoryApp.src.Modules.Teacher.Coursework.QuestionFunction.Views.QuestionManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules"
    xmlns:helper="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Coursework.QuestionFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="QuestionManagerPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  List câu hỏi  -->
        <Grid Grid.Column="0" />

        <!--  Thông tin bài tập  -->
        <Border
            Grid.Column="1"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel VerticalAlignment="Center">
                        <!--  Thông tin bài tập  -->
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding SelectedExercise.Title}"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,10,0,5"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            Foreground="#acacff"
                            Text="{Binding SelectedExercise.OwnerInfo.Username}"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,5"
                            HorizontalAlignment="Center"
                            Text="{Binding SelectedExercise.Description}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,5,0,10"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#f38872"
                            Text="{Binding SelectedExercise.Instruction}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom">
                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="SpringGreen"
                        BorderThickness="0"
                        Command="{Binding AddQuestionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Kind="Add" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Thêm câu hỏi" />
                        </Grid>
                    </Button>

                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ffff72"
                        BorderThickness="0"
                        Command="{Binding}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Kind="Eye" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Xem trước" />
                        </Grid>
                    </Button>

                    <Button
                        Width="150"
                        Height="32"
                        Margin="0,0,0,10"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="Cyan"
                        BorderThickness="0"
                        Command="{Binding}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Kind="Play" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="Làm bài" />
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
