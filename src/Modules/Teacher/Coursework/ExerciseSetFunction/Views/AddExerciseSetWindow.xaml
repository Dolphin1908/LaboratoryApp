<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseSetFunction.Views.AddExerciseSetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules"
    xmlns:helper="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseSetFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Thêm bộ bài tập mới"
    Width="400"
    Height="400"
    MinWidth="400"
    MinHeight="400"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <StackPanel Margin="10">
        <!--  Thông tin chung  -->
        <TextBlock
            Margin="0,0,0,5"
            FontSize="20"
            FontWeight="Bold"
            Text="Thông tin chung" />

        <TextBox
            Margin="0,0,0,20"
            VerticalAlignment="Top"
            materialDesign:HintAssist.Hint="Tên bộ bài tập"
            Style="{StaticResource MaterialDesignOutlinedTextBox}">
            <TextBox.Text>
                <Binding Path="ExerciseSet.Title" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <rules:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <TextBox
            Margin="0,0,0,20"
            VerticalAlignment="Top"
            materialDesign:HintAssist.Hint="Mô tả (tùy chọn)"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            Text="{Binding ExerciseSet.Description, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Cài đặt  -->
        <TextBlock
            Margin="0,0,0,5"
            FontSize="20"
            FontWeight="Bold"
            Text="Cài đặt" />

        <PasswordBox
            Margin="0,0,0,20"
            VerticalContentAlignment="Top"
            helper:PasswordBoxHelper.Attach="True"
            helper:PasswordBoxHelper.Password="{Binding ExerciseSet.Password, Mode=TwoWay}"
            materialDesign:HintAssist.Hint="Mật khẩu (Tùy chọn)"
            materialDesign:TextFieldAssist.HasClearButton="True"
            Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" />

        <CheckBox
            Margin="0,0,20,20"
            Padding="5,0,0,0"
            Content="Công khai"
            IsChecked="{Binding ExerciseSet.IsPublic}" />

        <!--  Nút  -->
        <Button
            Width="150"
            materialDesign:ButtonAssist.CornerRadius="10"
            Background="SpringGreen"
            BorderThickness="0"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
            Content="Done"
            Foreground="Black"
            Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
    </StackPanel>
</Window>
