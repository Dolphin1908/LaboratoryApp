<Page
    x:Class="LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseSetFunction.Views.ExerciseSetManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Coursework.ExerciseSetFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Quản lý bài học"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="5"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Kind="Magnify" />

                        <Grid Grid.Column="1">
                            <TextBox
                                Name="SearchBox"
                                Margin="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CaretBrush="Black"
                                Foreground="Black"
                                Style="{x:Null}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <Popup
                                Name="SearchPopup"
                                Width="{Binding ActualWidth, ElementName=SearchBox}"
                                Margin="0"
                                AllowsTransparency="True"
                                IsOpen="{Binding ., Mode=OneWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=SearchBox}"
                                PopupAnimation="Fade"
                                StaysOpen="False"
                                VerticalOffset="5">

                                <ScrollViewer
                                    MaxHeight="400"
                                    Margin="0"
                                    VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Height="60"
                                                    Margin="0"
                                                    Padding="5,0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="LightGray"
                                                    BorderThickness="0"
                                                    Command="{Binding}"
                                                    CommandParameter="{Binding .}"
                                                    Cursor="Hand">
                                                    <!--    -->
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Grid.Column="1"
                    Width="Auto"
                    Height="Auto"
                    Margin="5"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="Cyan"
                    BorderThickness="0"
                    Command="{Binding InsertExerciseSet}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Kind="Add" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Nhập bộ" />
                    </Grid>
                </Button>

                <Button
                    Grid.Column="2"
                    Width="Auto"
                    Height="Auto"
                    Margin="5"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="SpringGreen"
                    BorderThickness="0"
                    Command="{Binding AddNewSetCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Kind="Add" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Thêm bộ mới" />
                    </Grid>
                </Button>
            </Grid>

            <Separator
                Width="200"
                Height="1"
                Background="Gray"
                BorderBrush="Gray" />
        </StackPanel>

        <ItemsControl
            Grid.Row="1"
            Margin="5,0"
            VerticalAlignment="Top"
            ItemsSource="{Binding ExerciseSets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Margin="5"
                        Background="Transparent"
                        BorderBrush="Black"
                        Command="{Binding DataContext.OpenExerciseSetCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                        CommandParameter="{Binding .}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Margin="5,0" Text="-" />
                            <TextBlock Foreground="MediumPurple" Text="{Binding OwnerInfo.Username}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
