<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.AssessmentFunction.ExerciseFunction.Views.ExerciseDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.AssessmentFunction.ExerciseFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LaboratoryApp.src.Modules.Teacher.AssessmentFunction.ExerciseFunction.ViewModels.Items"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Chi tiết bài tập"
    Width="800"
    Height="450"
    MinWidth="600"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DetailQuestionViewModel}">
            <Border
                Margin="0,10"
                Padding="15,15,10,15"
                Background="White"
                BorderBrush="#EEEEEE"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <DockPanel Margin="0" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#2E86DE"
                            Text="{Binding DisplayIndex, StringFormat='{}{0}: '}" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontStyle="Italic"
                            Foreground="Gray"
                            Text="{Binding Model.Points, StringFormat='({0} điểm)'}" />
                        <materialDesign:Chip
                            Height="20"
                            Content="{Binding Model.Type}"
                            DockPanel.Dock="Right"
                            FontSize="10" />
                    </DockPanel>

                    <RichTextBox
                        Margin="0,10"
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        helper:RichTextBoxBindingHelper.DocumentXaml="{Binding Model.Title, UpdateSourceTrigger=PropertyChanged}"
                        helper:RichTextBoxFormatHelper.Align="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        FontFamily="Times New Roman"
                        FontSize="16"
                        Foreground="Black"
                        IsHitTestVisible="False"
                        IsReadOnly="True">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <ItemsControl ItemsSource="{Binding Model.AnswerOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        Background="#F5F5F5"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding OrderIndex}" />
                                    </Border>
                                    <RichTextBox
                                        Grid.Column="1"
                                        Margin="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        helper:RichTextBoxBindingHelper.DocumentXaml="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                        helper:RichTextBoxFormatHelper.Align="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        FontFamily="Times New Roman"
                                        FontSize="16"
                                        Foreground="Black"
                                        IsHitTestVisible="False"
                                        IsReadOnly="True">
                                        <RichTextBox.Resources>
                                            <Style TargetType="{x:Type Paragraph}">
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </RichTextBox.Resources>
                                    </RichTextBox>

                                    <materialDesign:PackIcon
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Foreground="Green"
                                        Kind="CheckCircle"
                                        Visibility="{Binding IsCorrect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DetailBlockViewModel}">
            <Border
                Margin="0,0,0,30"
                Padding="15"
                Background="#F9FAFB"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="20"
                        FontStyle="Italic"
                        Foreground="Gray"
                        Text="{Binding Model.Title}" />

                    <RichTextBox
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        helper:RichTextBoxBindingHelper.DocumentXaml="{Binding Model.Content, UpdateSourceTrigger=PropertyChanged}"
                        helper:RichTextBoxFormatHelper.Align="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        FontFamily="Times New Roman"
                        FontSize="16"
                        Foreground="Black"
                        IsHitTestVisible="False"
                        IsReadOnly="True">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <ItemsControl Margin="20,0,0,0" ItemsSource="{Binding Children, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="10"
            Background="White"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="THÔNG TIN BÀI TẬP" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            FontSize="14"
                            Foreground="Gray"
                            Text="Tiêu đề:" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding CurrExercise.Title}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            FontSize="14"
                            Foreground="Gray"
                            Text="Mô tả:" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding CurrExercise.Description}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            FontSize="14"
                            Foreground="Gray"
                            Text="Giao cho:" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Chưa có"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="14"
                        Foreground="Gray"
                        Text="Cấu hình:" />

                    <StackPanel
                        Margin="0,0,0,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <wpfui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="Clock24" />
                        <TextBlock
                            Margin="0,-2,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="Black"
                            Text="{Binding CurrExercise.DurationInMinutes, StringFormat=' {0} phút'}" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,0,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <wpfui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="Target24" />
                        <TextBlock
                            Margin="0,-2,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="Black"
                            Text="{Binding CurrExercise.PassScore, StringFormat=' {0} điểm'}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button
                        Margin="0,0,0,10"
                        Content="Chỉnh sửa đề"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Xuất PDF" Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid Margin="20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="NỘI DUNG BÀI TẬP" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding ContentItems}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
