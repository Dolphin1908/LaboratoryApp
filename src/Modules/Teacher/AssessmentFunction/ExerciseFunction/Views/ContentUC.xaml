<UserControl
    x:Class="LaboratoryApp.src.Modules.Teacher.AssessmentFunction.ExerciseFunction.Views.ContentUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.AssessmentFunction.ExerciseFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="clr-namespace:LaboratoryApp.src.Core.Rules"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <materialDesign:PackIcon
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                Foreground="SpringGreen"
                Kind="Numeric1Circle" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="SpringGreen"
                Text="Informations" />
            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="10,0"
                VerticalAlignment="Center"
                Foreground="SpringGreen"
                Kind="ArrowRightThin" />
            <materialDesign:PackIcon
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                Foreground="PaleGoldenrod"
                Kind="Numeric2Circle" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="PaleGoldenrod"
                Text="Questions" />
            <materialDesign:PackIcon
                Width="32"
                Height="32"
                Margin="10,0"
                VerticalAlignment="Center"
                Foreground="PaleGoldenrod"
                Kind="ArrowRightThin" />
            <materialDesign:PackIcon
                Width="28"
                Height="28"
                Foreground="#000"
                Kind="Numeric3Circle" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#000"
                Text="Settings" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="#FFF"
            Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0">
                    <StackPanel>
                        <!--  Ngân hàng câu hỏi  -->
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Ngân hàng câu hỏi" />
                        <!--  Khung tìm kiếm  -->
                        <!--  Bộ lọc  -->
                        <!--  Kết quả tìm kiếm  -->
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="20,0,0,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="18"
                                    Style="{StaticResource CardTitleStyle}"
                                    Text="Câu hỏi trong bộ" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                                    Text="Danh sách các câu hỏi đã thêm" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Background="SpringGreen"
                                BorderBrush="SpringGreen"
                                Command="{Binding CreateNewQuestionCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <wpfui:SymbolIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="Add24" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Thêm câu hỏi" />
                                </Grid>
                            </Button>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="0,0,5,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExerciseItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,12"
                                            Background="{DynamicResource MaterialDesignPaper}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="10"
                                                    Direction="270"
                                                    Opacity="0.1"
                                                    ShadowDepth="2"
                                                    Color="Gray" />
                                            </Border.Effect>

                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="45"
                                                    Height="45"
                                                    Margin="0,0,15,0"
                                                    Background="#F0F0F0"
                                                    CornerRadius="8">
                                                    <materialDesign:PackIcon
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Kind="{Binding IconKind}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <RichTextBox
                                                        Margin="0,0,0,4"
                                                        Padding="0"
                                                        helper:RichTextBoxBindingHelper.DocumentXaml="{Binding Model.Title}"
                                                        helper:RichTextBoxFormatHelper.Align="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Focusable="False"
                                                        FontFamily="Times New Roman"
                                                        FontSize="20"
                                                        Foreground="Black"
                                                        IsHitTestVisible="False"
                                                        IsReadOnly="True">
                                                        <RichTextBox.Resources>
                                                            <Style TargetType="{x:Type Paragraph}">
                                                                <Setter Property="Margin" Value="0" />
                                                            </Style>
                                                        </RichTextBox.Resources>
                                                    </RichTextBox>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Padding="0,2"
                                                            Background="{DynamicResource PrimaryHueLightBrush}"
                                                            CornerRadius="4">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                Text="{Binding Model.Type, Converter={StaticResource EnumDisplayNameConverter}}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="2"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Background="#FFF8E1"
                                                    BorderBrush="Orange"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Visibility="{Binding Model.IsBlock, Converter={StaticResource InverseBooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="Orange"
                                                            Kind="Star" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="Bold"
                                                            Foreground="Orange"
                                                            Text="{Binding Model.Points, StringFormat='{}{0} đ'}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FAFAFA" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
