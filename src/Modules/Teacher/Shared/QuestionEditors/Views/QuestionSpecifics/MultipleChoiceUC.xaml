<UserControl
    x:Class="LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views.QuestionSpecifics.MultipleChoiceUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LaboratoryApp.src.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views.QuestionSpecifics"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MaxHeight="200"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl
                    Grid.Row="0"
                    AlternationCount="100"
                    ItemsSource="{Binding AnswerOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.OptionCheckedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsChecked="{Binding IsCorrect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Width="20"
                                    Margin="5,0,10,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToLetterConverter}}" />

                                <TextBox
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="Nhập nội dung đáp án..."
                                    BorderThickness="0"
                                    Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />

                                <Button
                                    Grid.Column="3"
                                    Width="25"
                                    Height="25"
                                    Command="{Binding DataContext.RemoveAnswerOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Xóa đáp án này">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Foreground="Red"
                                        Kind="Close" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding AddAnswerOptionCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Plus" />
                        <TextBlock Padding="0" Text="Thêm phương án" />
                    </StackPanel>
                </Button>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
