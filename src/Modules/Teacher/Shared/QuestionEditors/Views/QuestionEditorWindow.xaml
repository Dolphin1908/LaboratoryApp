<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views.QuestionEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:LaboratoryApp.src.Shared.UserControls"
    xmlns:vSpecifics="clr-namespace:LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views.QuestionSpecifics"
    xmlns:vmSpecifics="clr-namespace:LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.ViewModels.QuestionSpecifics"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Tạo câu hỏi mới"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmSpecifics:MultipleChoiceViewModel}">
            <vSpecifics:MultipleChoiceUC />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="0,0,0,10"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="Loại câu hỏi: " />
            <ComboBox
                Width="200"
                Height="25"
                Padding="5,0"
                ItemsSource="{Binding QuestionTypeOptions}"
                SelectedValue="{Binding SelectedQuestionType, Mode=TwoWay}"
                SelectedValuePath="Value"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="Bold"
                Text="Nội dung câu hỏi: " />
            <Border
                Grid.Row="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="5"
                        Background="#F9F9F9"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Left"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn trái">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignLeft" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Center"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn giữa">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignCenter" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn phải">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignRight" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Justify"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn đều">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignJustify" />
                                </Button>
                            </StackPanel>

                            <Grid Margin="5,0">
                                <Button
                                    Padding="4,0"
                                    VerticalContentAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding OpenFontColorCommand}">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Text="A" />
                                            <Border
                                                Grid.Row="1"
                                                Height="3"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" />
                                        </Grid>
                                        <materialDesign:PackIcon
                                            Grid.Column="1"
                                            Width="12"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Kind="ChevronDown" />
                                    </Grid>
                                </Button>
                                <Popup
                                    IsOpen="{Binding IsPopupOpen}"
                                    Placement="Bottom"
                                    StaysOpen="False">
                                    <shared:ColorPicker DataContext="{Binding .}" />
                                </Popup>
                            </Grid>
                        </WrapPanel>
                    </Border>

                    <RichTextBox
                        Grid.Row="1"
                        Padding="10,10,5,10"
                        VerticalContentAlignment="Stretch"
                        helpers:RichTextBoxBindingHelper.DocumentXaml="{Binding XamlDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        helpers:RichTextBoxFormatHelper.Align="{Binding SelectedAlignment, Mode=TwoWay}"
                        helpers:RichTextBoxFormatHelper.FontSize="{Binding SelectedFontSize, Mode=TwoWay}"
                        helpers:RichTextBoxFormatHelper.Foreground="{Binding SelectedColor, Mode=TwoWay}"
                        AcceptsTab="True"
                        BorderThickness="0"
                        VerticalScrollBarVisibility="Hidden" />
                </Grid>
            </Border>
        </Grid>

        <!--  UC cho từng loại câu hỏi  -->
        <ContentControl
            Grid.Row="2"
            Margin="0,0,0,10"
            Content="{Binding CurrentContentVM, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Điểm mặc định: " />
                <TextBox
                    Width="60"
                    Height="25"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Model.Points}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="#989898"
                    BorderBrush="#989898"
                    Command="{Binding CancelAddQuestionCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpfui:SymbolIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="ArrowLeft24" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Quay lại" />
                    </Grid>
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="5,0"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="SpringGreen"
                    BorderBrush="SpringGreen"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpfui:SymbolIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="Save24" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Lưu vào bài tập" />
                    </Grid>
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="#2e86de"
                    BorderBrush="#2e86de"
                    Command="{Binding NavigateToPreviousPage}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpfui:SymbolIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="Save24" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Lưu vào bài tập và ngân hàng" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
