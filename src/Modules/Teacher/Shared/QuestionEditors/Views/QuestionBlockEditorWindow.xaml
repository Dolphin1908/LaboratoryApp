<Window
    x:Class="LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views.QuestionBlockEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:helpers="clr-namespace:LaboratoryApp.src.Core.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.Shared.QuestionEditors.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:LaboratoryApp.src.Shared.UserControls"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Tạo khối câu hỏi mới"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Block title  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="Tiêu đề khối: " />
            <TextBox
                Grid.Column="1"
                Height="24"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="16"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding BlockTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  Shared Content  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="Bold"
                Text="Nội dung chung (Đoạn văn, dữ kiện,...)" />
            <Border
                Grid.Row="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="5"
                        Background="#F9F9F9"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Left"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn trái">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignLeft" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Center"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn giữa">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignCenter" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn phải">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignRight" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,1,0"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="Justify"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="Căn đều">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Foreground="Black"
                                        Kind="FormatAlignJustify" />
                                </Button>
                            </StackPanel>

                            <Grid Margin="5,0">
                                <Button
                                    Padding="4,0"
                                    VerticalContentAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding OpenFontColorCommand}">
                                    <Grid VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Text="A" />
                                            <Border
                                                Grid.Row="1"
                                                Height="3"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" />
                                        </Grid>
                                        <materialDesign:PackIcon
                                            Grid.Column="1"
                                            Width="12"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Kind="ChevronDown" />
                                    </Grid>
                                </Button>
                                <Popup
                                    IsOpen="{Binding IsPopupOpen}"
                                    Placement="Bottom"
                                    StaysOpen="False">
                                    <shared:ColorPicker DataContext="{Binding .}" />
                                </Popup>
                            </Grid>
                        </WrapPanel>
                    </Border>

                    <RichTextBox
                        Grid.Row="1"
                        Padding="10,10,5,10"
                        VerticalContentAlignment="Stretch"
                        helpers:RichTextBoxBindingHelper.DocumentXaml="{Binding XamlDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        helpers:RichTextBoxFormatHelper.Align="{Binding SelectedAlignment, Mode=TwoWay}"
                        helpers:RichTextBoxFormatHelper.FontSize="{Binding SelectedFontSize, Mode=TwoWay}"
                        helpers:RichTextBoxFormatHelper.Foreground="{Binding SelectedColor, Mode=TwoWay}"
                        AcceptsTab="True"
                        BorderThickness="0"
                        VerticalScrollBarVisibility="Hidden" />
                </Grid>
            </Border>
        </Grid>

        <!--  Sub Question  -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="Bold"
                Text="Danh sách câu hỏi con" />

            <ScrollViewer
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="0,0,5,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Children}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Direction="270"
                                        Opacity="0.1"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>

                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,15,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource MaterialDesignChipBackground}"
                                        CornerRadius="8">
                                        <materialDesign:PackIcon
                                            Width="24"
                                            Height="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Kind="{Binding IconKind}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <RichTextBox
                                            Margin="0"
                                            Padding="0"
                                            helper:RichTextBoxBindingHelper.DocumentXaml="{Binding Model.Title, UpdateSourceTrigger=PropertyChanged}"
                                            helper:RichTextBoxFormatHelper.Align="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            FontFamily="Times New Roman"
                                            FontSize="20"
                                            Foreground="Black"
                                            IsHitTestVisible="False"
                                            IsReadOnly="True">
                                            <RichTextBox.Resources>
                                                <Style TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                            </RichTextBox.Resources>
                                        </RichTextBox>

                                        <Border
                                            Padding="0,2"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource PrimaryHueLightBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontFamily="Times New Roman"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                Text="{Binding Model.Type, Converter={StaticResource EnumDisplayNameConverter}}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Border
                                            Margin="0,0,10,0"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="#FFF8E1"
                                            BorderBrush="Orange"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="Orange"
                                                    Kind="Star" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Foreground="Orange"
                                                    Text="{Binding Model.Points, StringFormat='{}{0} đ'}" />
                                            </StackPanel>
                                        </Border>

                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#E57373"
                                            Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" />
                                        </Button>

                                    </StackPanel>
                                </Grid>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Height="45"
                HorizontalAlignment="Stretch"
                materialDesign:ButtonAssist.CornerRadius="8"
                Background="Transparent"
                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                BorderThickness="1"
                Command="{Binding AddChildQuestionCommand}"
                Content="{materialDesign:PackIcon Kind=Plus,
                                                  Size=24}"
                Foreground="{DynamicResource PrimaryHueMidBrush}"
                Style="{StaticResource MaterialDesignFlatButton}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Kind="PlusCircleOutline" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Thêm câu hỏi con" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </Grid>

        <!--  Action buttons  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Margin="0,0,5,0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#989898"
                BorderBrush="#989898"
                Command="{Binding CancelAddBlockCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="ArrowLeft24" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="Quay lại" />
                </Grid>
            </Button>
            <Button
                Grid.Column="1"
                Margin="5,0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="SpringGreen"
                BorderBrush="SpringGreen"
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="Save24" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="Lưu vào bài tập" />
                </Grid>
            </Button>
            <Button
                Grid.Column="2"
                Margin="5,0,0,0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="#2e86de"
                BorderBrush="#2e86de"
                Command="{Binding NavigateToPreviousPage}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="Save24" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="Lưu vào bài tập và ngân hàng" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
