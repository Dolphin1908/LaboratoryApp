<Page
    x:Class="LaboratoryApp.src.Modules.Teacher.DashboardFunction.Views.TeacherMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Teacher.DashboardFunction.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TeacherDashboardPage"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Style cho các thẻ thống kê (Stats Card)  -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!--  Style cho Text tiêu đề trong thẻ  -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Style cho con số trong thẻ  -->
        <Style x:Key="CardNumberStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Hidden">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="Auto" />
                <!--  Stats Cards  -->
                <RowDefinition Height="Auto" />
                <!--  Chart Section  -->
                <RowDefinition Height="Auto" />
                <!--  Recent Activity Header  -->
                <RowDefinition Height="*" />
                <!--  Recent Activity List  -->
            </Grid.RowDefinitions>

            <!--  1. HEADER  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,15,0"
                    FontSize="32"
                    Foreground="#333"
                    Symbol="Board24" />
                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Text="Teacher Dashboard" />
            </StackPanel>

            <!--  2. STATS CARDS  -->
            <UniformGrid
                Grid.Row="1"
                Margin="0,0,-20,20"
                Columns="3">
                <!--  Card 1: Pending Grading (Orange)  -->
                <Border Background="#FF9F43" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource CardTitleStyle}"
                            Text="Pending Grading" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CardNumberStyle}"
                            Text="15" />
                    </Grid>
                </Border>

                <!--  Card 2: Students Submitted (Blue)  -->
                <Border Background="#2E86DE" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource CardTitleStyle}"
                            Text="Submitted Today" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CardNumberStyle}"
                            Text="42" />
                    </Grid>
                </Border>

                <!--  Card 3: Assignments Due (Red)  -->
                <Border Background="#EE5253" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource CardTitleStyle}"
                            Text="Due Soon" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CardNumberStyle}"
                            Text="3" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!--  3. WEEKLY STUDENT ACTIVITY CHART (LiveCharts)  -->
            <materialDesign:Card
                Grid.Row="2"
                Margin="0,0,0,20"
                UniformCornerRadius="10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="400" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        Text="Weekly Student Activity" />

                    <lvc:CartesianChart
                        Grid.Row="1"
                        LegendLocation="None"
                        Series="{Binding ActivitySeries}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding ActivityLabels}">
                                <lvc:Axis.Foreground>
                                    <SolidColorBrush Color="Gray" />
                                </lvc:Axis.Foreground>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MaxValue="70" MinValue="0">
                                <lvc:Axis.Separator>
                                    <lvc:Separator
                                        Step="20"
                                        Stroke="#F0F0F0"
                                        StrokeThickness="1" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip SelectionMode="OnlySender" />
                        </lvc:CartesianChart.DataTooltip>
                    </lvc:CartesianChart>
                </Grid>
            </materialDesign:Card>

            <!--  4. RECENT ACTIVITY HEADER  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,0,0,15"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{DynamicResource MaterialDesignBody}"
                Text="Recent Activity" />

            <!--  5. RECENT ACTIVITY LIST  -->
            <ItemsControl
                x:Name="ActivityList"
                Grid.Row="4"
                ItemsSource="{Binding RecentActivities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card
                            Margin="0,0,0,10"
                            Padding="15"
                            UniformCornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Icon  -->
                                    <ColumnDefinition Width="*" />
                                    <!--  Text  -->
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Time  -->
                                </Grid.ColumnDefinitions>

                                <!--  Icon Indicator  -->
                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,15,0"
                                    Background="#E3F2FD"
                                    CornerRadius="20">
                                    <wpfui:SymbolIcon
                                        FontSize="20"
                                        Foreground="#2E86DE"
                                        Symbol="DocumentBulletList24" />
                                </Border>

                                <!--  Content  -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{Binding SubDetail}" />
                                </StackPanel>

                                <!--  Time  -->
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{Binding TimeAgo}" />
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</Page>