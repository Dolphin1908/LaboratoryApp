<Window
    x:Class="LaboratoryApp.src.Modules.Auth.Views.RoleSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Auth.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Chọn Đơn vị &amp; Vai trò"
    Width="400"
    Height="400"
    MinWidth="400"
    MinHeight="400"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Màu chủ đạo (Primary Blue giống Windows 11)  -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E5F3FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E6E" />

        <!--  Style cho Scrollbar để nhìn gọn hơn  -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
        </Style>

        <!--  Style cho từng Item (Card) trong ListBox  -->
        <Style x:Key="RoleCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="RootBorder"
                            Padding="16"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8">
                            <!--  Hiệu ứng đổ bóng nhẹ  -->
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="270"
                                    Opacity="0.05"
                                    ShadowDepth="2"
                                    Color="Black" />
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Icon  -->
                                    <ColumnDefinition Width="*" />
                                    <!--  Text  -->
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Checkmark  -->
                                </Grid.ColumnDefinitions>

                                <!--  Icon tổ chức/Building  -->
                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,16,0"
                                    Background="#F3F3F3"
                                    CornerRadius="20">
                                    <Path
                                        Margin="10"
                                        Data="M12,7V3H2V18H22V7H12M6,19H2V21H6V19M18,19H14V21H18V19M18,15H14V17H18V15M18,11H14V13H18V11M18,7H14V9H18V7M10,19H6V21H10V19M10,15H6V17H10V15M10,11H6V13H10V11M10,7H6V9H10V7Z"
                                        Fill="{StaticResource TextSecondaryBrush}"
                                        Stretch="Uniform" />
                                </Border>

                                <!--  Nội dung Text  -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding OrganizationName}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <!--  Icon User nhỏ  -->
                                        <Path
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                            Fill="{StaticResource TextSecondaryBrush}"
                                            Stretch="Uniform" />

                                        <!--  Role Text  -->
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding Role, Converter={StaticResource HighestNameFlagConverter}, FallbackValue='Admin'}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Dấu tích xanh khi được chọn  -->
                                <Border
                                    x:Name="CheckMark"
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <Path
                                        Margin="5"
                                        Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                        Fill="White"
                                        Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Triggers cho Hover và Selection  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FAFAFA" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style cho Button Save  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#E0E0E0" />
                                <Setter Property="Foreground" Value="#A0A0A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  Main Container với bo góc và đổ bóng cho Window  -->
    <Border
        Background="#F9F9F9"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        CornerRadius="10">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="*" />
                <!--  List  -->
                <RowDefinition Height="50" />
                <!--  Footer  -->
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Chọn Tổ chức &amp; Vai trò" />

                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Vui lòng chọn đơn vị để tiếp tục" />
            </StackPanel>

            <!--  List Roles  -->
            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource RoleCardItemStyle}"
                ItemsSource="{Binding Roles}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding SelectedRole}"
                SelectionMode="Single" />

            <!--  Footer Buttons  -->
            <!--  Nút Save  -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="175"
                    Height="30"
                    Margin="0,10,5,5"
                    Background="#989898"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="Hủy"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <Button
                    Width="175"
                    Height="30"
                    Margin="5,10,0,5"
                    Command="{Binding ConfirmRoleCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="Xác nhận truy cập"
                    Style="{StaticResource PrimaryButtonStyle}" />

            </StackPanel>
        </Grid>
    </Border>
</Window>
