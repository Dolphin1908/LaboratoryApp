<Page
    x:Class="LaboratoryApp.src.Modules.Tools.Chemistry.DictionaryFunction.CompoundFunction.Views.CompoundManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Tools.Chemistry.DictionaryFunction.CompoundFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Compound"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="5"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Kind="Magnify" />

                        <Grid Grid.Column="1">
                            <TextBox
                                Name="SearchBox"
                                Margin="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CaretBrush="Black"
                                Foreground="Black"
                                Style="{x:Null}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <Popup
                                Name="SearchPopup"
                                Width="{Binding ActualWidth, ElementName=SearchBox}"
                                Margin="0"
                                AllowsTransparency="True"
                                IsOpen="{Binding Compounds.Count, Mode=OneWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=SearchBox}"
                                PopupAnimation="Fade"
                                StaysOpen="False"
                                VerticalOffset="5">

                                <ScrollViewer
                                    MaxHeight="400"
                                    Margin="0"
                                    VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl ItemsSource="{Binding Compounds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Height="60"
                                                    Margin="0"
                                                    Padding="5,0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="LightGray"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectCompoundCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding .}"
                                                    Cursor="Hand">
                                                    <local:CompoundSearchResultUC HorizontalAlignment="Left" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Grid.Column="1"
                    Width="Auto"
                    Height="Auto"
                    Margin="5"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="SpringGreen"
                    BorderThickness="0"
                    Command="{Binding AddCompoundCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Kind="Add" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Thêm hợp chất" />
                    </Grid>
                </Button>
            </Grid>

            <Separator
                Width="200"
                Height="1"
                Background="Gray"
                BorderBrush="Gray" />
        </StackPanel>

        <local:CompoundSelectionResultUC
            Grid.Row="1"
            Margin="10,0"
            DataContext="{Binding SelectedCompound}"
            Visibility="{Binding DataContext.SelectedCompound, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource NullToVisibilityConverter}}" />
    </Grid>
</Page>
