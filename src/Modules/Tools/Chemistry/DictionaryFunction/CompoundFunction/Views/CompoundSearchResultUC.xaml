<UserControl
    x:Class="LaboratoryApp.src.Modules.Tools.Chemistry.DictionaryFunction.CompoundFunction.Views.CompoundSearchResultUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Tools.Chemistry.DictionaryFunction.CompoundFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="left">
        <StackPanel Margin="0,5" Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Left"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkSlateBlue"
                Text="{Binding Formula}" />
            <TextBlock FontSize="12" Text="{Binding Name}" />
            <TextBlock FontSize="12" Text="{Binding MolecularMass}" />
        </StackPanel>
    </Grid>
</UserControl>
