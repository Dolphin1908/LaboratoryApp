<Window
    x:Class="LaboratoryApp.src.Modules.Chemistry.PeriodicFunction.Views.ElementInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Chemistry.PeriodicFunction.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="ElementInfoWindow"
    Title="Chi tiết nguyên tố"
    MinWidth="400"
    MinHeight="450"
    MaxWidth="400"
    MaxHeight="450"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Border Background="{Binding Element.Color, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="10">
        <Grid
            Margin="0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontSize="80"
                    FontWeight="Bold"
                    Text="{Binding Element.Formula}" />
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontStyle="Italic"
                    Text="{Binding Element.Name}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock FontSize="12" Text="Khối lượng nguyên tử: " />
                    <TextBlock FontSize="12" Text="Cấu hình electron: " />
                    <TextBlock FontSize="12" Text="Điện tích hóa trị: " />
                    <TextBlock FontSize="12" Text="Bán kính nguyên tử: " />
                    <TextBlock FontSize="12" Text="Năng lượng ion hóa: " />
                    <TextBlock FontSize="12" Text="Năng lượng electron hóa: " />
                    <TextBlock FontSize="12" Text="Trạng thái ôxi hóa: " />
                    <TextBlock FontSize="12" Text="Trạng thái: " />
                    <TextBlock FontSize="12" Text="Nhiệt độ nóng chảy: " />
                    <TextBlock FontSize="12" Text="Nhiệt độ sôi: " />
                    <TextBlock FontSize="12" Text="Tỉ trọng: " />
                    <TextBlock FontSize="12" Text="Phân loại: " />
                    <TextBlock FontSize="12" Text="Năm phát hiện: " />
                    <TextBlock FontSize="12" Text="Màu thực tế: " />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Text="{Binding Element.AtomicMass}" />
                    <TextBlock FontSize="12" Text="{Binding Element.ElectronConfiguration}" />
                    <TextBlock FontSize="12" Text="{Binding Element.Electronegativity}" />
                    <TextBlock FontSize="12" Text="{Binding Element.AtomicRadius}" />
                    <TextBlock FontSize="12" Text="{Binding Element.IonizationEnergy}" />
                    <TextBlock FontSize="12" Text="{Binding Element.ElectronAffinity}" />
                    <TextBlock FontSize="12" Text="{Binding Element.OxidationStates}" />
                    <TextBlock FontSize="12" Text="{Binding Element.Phase}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Text="{Binding Element.MeltingPoint}" />
                        <TextBlock FontSize="12" Text=" (K)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Text="{Binding Element.BoilingPoint}" />
                        <TextBlock FontSize="12" Text=" (K)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Text="{Binding Element.Density}" />
                        <TextBlock FontSize="12" Text=" (g/cm³)" />
                    </StackPanel>
                    <TextBlock FontSize="12" Text="{Binding Element.Category}" />
                    <TextBlock FontSize="12" Text="{Binding Element.DiscoveryYear}" />
                    <ItemsControl ItemsSource="{Binding Element.RealColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="20"
                                    Height="12"
                                    Margin="2"
                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Button
                    Width="100"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="WhiteSmoke"
                    BorderThickness="0"
                    Command="{Binding CloseElementInfoCommand}"
                    CommandParameter="{Binding ElementName=ElementInfoWindow}"
                    Content="Done"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
            </Grid>
        </Grid>
    </Border>
</Window>
