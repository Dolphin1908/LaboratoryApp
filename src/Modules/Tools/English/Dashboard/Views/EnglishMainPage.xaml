<Page
    x:Class="LaboratoryApp.src.Modules.Tools.English.Dashboard.Views.EnglishMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LaboratoryApp.src.Modules.Tools.English.Dashboard.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EnglishMainWindow"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Grid
        Margin="100,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Stretch">
            <Image
                Width="64"
                Height="64"
                Margin="0,0,0,20"
                Source="/resources/Images/Laboratory.png" />
            <TextBlock
                Margin="8"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Welcome to English Course" />
            <Grid
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#92ff9f"
                        BorderBrush="#92ff9f"
                        Command="{Binding OpenDictionaryCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="Từ điển Anh - Việt" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#fff991"
                        BorderBrush="#fff991"
                        Command="{Binding NavigateToFlashcardManagerCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="Flashcard" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ff9e40"
                        BorderBrush="#ff9e40"
                        Command="{Binding NavigateToLectureCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="Bài giảng" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ff96c8"
                        BorderBrush="#ff96c8"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="Luyện nghe" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#d872e8"
                        BorderBrush="#d872e8"
                        Command="{Binding NavigateToDiaryCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="Luyện viết nhật ký" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#ff6c56"
                        BorderBrush="#ff6c56"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="None" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#18ffff"
                        BorderBrush="#18ffff"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="None" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#42a5f5"
                        BorderBrush="#42a5f5"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="None" />
                    </Button>
                </Grid>
                <Grid
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,0,10,10"
                    VerticalAlignment="Stretch">
                    <Button
                        Height="100"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Background="#989898"
                        BorderBrush="#989898"
                        Command="{Binding}"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock FontSize="16" Text="None" />
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
